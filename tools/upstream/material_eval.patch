@@ -47,6 +47,30 @@ Value Eval::evaluate(const Eval::NNUE::Network&     network,
 
     assert(!pos.checkers());
 
+    // SPINE ISOLATION: replace the NNUE forward pass and the eval blend with material alone.
+    // This MUST stay a line-for-line match of zfish's -Dstub-eval stub
+    // (src/engine/eval/evaluate.zig stubMaterialValue): the same five piece values, the same
+    // side-to-move perspective, and no optimism / complexity / rule50 damping / TB clamp on
+    // either side. If the two ever disagree by one centipawn the engines search DIFFERENT
